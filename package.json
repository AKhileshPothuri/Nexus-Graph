{
  "name": "@costline/nexus-graph",
  "version": "0.1.1",
  "description": "Code graph context engine for AI coding assistants — indexes Python/TS/JS as a symbol graph and serves token-budgeted context via MCP",
  "main": "dist/mcp/server.js",
  "exports": {
    ".": "./dist/mcp/server.js",
    "./indexer/db": "./dist/indexer/db.js",
    "./indexer/indexFile": "./dist/indexer/indexFile.js",
    "./graph/traversal": "./dist/graph/traversal.js",
    "./graph/scorer": "./dist/graph/scorer.js",
    "./context/budget": "./dist/context/budget.js"
  },
  "bin": {
    "nexus-graph": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "ts-node src/cli/main.ts",
    "index": "ts-node src/cli/main.ts index",
    "server": "ts-node src/cli/main.ts server",
    "viz": "ts-node src/cli/main.ts viz",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "code-graph",
    "symbol-graph",
    "context-engine",
    "claude",
    "ai",
    "tree-sitter",
    "python",
    "typescript",
    "javascript"
  ],
  "author": "Akhilesh Pothuri <akhileshpothuri24@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/AKhileshPothuri/Nexus-Graph#readme",
  "bugs": {
    "url": "https://github.com/AKhileshPothuri/Nexus-Graph/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AKhileshPothuri/Nexus-Graph.git"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/express": "^5.0.6",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "tiktoken": "^1.0.22",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "0.23.4",
    "tree-sitter-typescript": "^0.23.2"
  }
}
