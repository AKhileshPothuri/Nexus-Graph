{
  "name": "nexus-graph",
  "version": "0.1.0",
  "description": "Code graph context engine for AI coding assistants — indexes Python/TS/JS as a symbol graph and serves token-budgeted context via MCP",
  "main": "dist/mcp/server.js",
  "exports": {
    ".": "./dist/mcp/server.js",
    "./indexer/db": "./dist/indexer/db.js",
    "./indexer/indexFile": "./dist/indexer/indexFile.js",
    "./graph/traversal": "./dist/graph/traversal.js",
    "./graph/scorer": "./dist/graph/scorer.js",
    "./context/budget": "./dist/context/budget.js"
  },
  "bin": {
    "nexus-mcp": "dist/mcp/server.js",
    "nexus-mcp-http": "dist/mcp/http-server.js",
    "nexus-viz": "dist/viz/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "ts-node src/mcp/server.ts",
    "http": "ts-node src/mcp/http-server.ts",
    "viz": "ts-node src/viz/cli.ts"
  },
  "keywords": [
    "mcp",
    "code-graph",
    "symbol-graph",
    "context-engine",
    "claude",
    "ai",
    "tree-sitter",
    "python",
    "typescript",
    "javascript"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/express": "^5.0.6",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "tiktoken": "^1.0.22",
    "tree-sitter": "^0.25.0",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2"
  }
}
